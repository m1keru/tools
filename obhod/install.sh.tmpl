#!/usr/bin/env bash
# Installer for node "{{.Node}}", generated by obhod.
#
#   ssh root@SERVER 'bash -s -- --check' < install.sh       look, change nothing
#   ssh root@SERVER 'bash -s' < install.sh                  install or update
#   ssh root@SERVER 'bash -s -- --uninstall' < install.sh
#
# By default it touches only /opt/obhod, one service definition (a systemd
# unit, or an init script on a sysvinit host) and one system user, so it can
# run on a host that does other work. Anything wider is opt-in:
#
#   --install-deps    install missing curl/unzip with the package manager
#   --open-firewall   allow the node's ports in an active ufw or firewalld, or
#                     through plain iptables rules that close them
#   --from A,B        with --open-firewall and plain iptables rules: let in
#                     only these IPv4 addresses or networks
#   --tune-network    BBR and larger socket buffers; for a dedicated VPS only
#   --xray-zip PATH   use an Xray release archive already on the server
#
# Safe to run again: the service is restarted only after the new config
# passes Xray's own check, and the previous config comes back if the new
# one does not start. This file contains the node's private keys.
set -euo pipefail

XRAY_VERSION='{{.XrayVersion}}'
PREFIX=/opt/obhod
UNIT=obhod-xray
SVC_USER=obhod
TCP_PORTS='{{.TCPPorts}}'
UDP_PORTS='{{.UDPPorts}}'
# The override exists for the installer's own tests.
INITD="${OBHOD_INITD_DIR:-/etc/init.d}/$UNIT"
INIT="" # systemd or sysv; main decides

say() { printf '>> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# ver_ge A B X Y: is version A.B at least X.Y?
ver_ge() { [ "$1" -gt "$3" ] || { [ "$1" -eq "$3" ] && [ "$2" -ge "$4" ]; }; }

# port_busy tcp|udp PORT: is something already listening there?
port_busy() {
  local flag=-ltn
  if [ "$1" = udp ]; then flag=-lun; fi
  if command -v ss >/dev/null 2>&1; then
    ss "$flag" 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]$2\$"
  elif command -v netstat >/dev/null 2>&1; then
    netstat "$flag" 2>/dev/null | awk '{print $4}' | grep -Eq "[:.]$2\$"
  else
    return 1
  fi
}

# ipt_closed: which of the node's ports do plain iptables rules close? They do
# when INPUT comes to a rule that drops everything, or to a drop policy, and
# no rule above lets the port in. Prints the closed ones as "tcp/443 udp/443".
#
# shortcut: IPv4 rules only, and a rule is judged by its text, not by sending
# packets; add ip6tables when a node is reached over IPv6, and a real probe
# when a ruleset fools this.
ipt_closed() {
  command -v iptables >/dev/null 2>&1 || return 0
  { iptables -S INPUT || true; iptables -S OBHOD || true; } 2>/dev/null |
    awk -v tcp="$TCP_PORTS" -v udp="$UDP_PORTS" '
      function let_in(proto, port,    i) {
        for (i = 1; i <= n; i++) if (pr[i] == proto && port + 0 >= lo[i] && port + 0 <= hi[i]) return 1
        return 0
      }
      /^-P INPUT DROP/ { policy = 1 }
      / -j (ACCEPT|DROP|REJECT)/ {
        rule = $0
        gsub(/ -m comment --comment ("[^"]*"|[^ ]+)/, "", rule)
        # The first rule that takes every packet decides. One tied to an
        # interface counts only as a drop: loopback being open says nothing
        # about the outside.
        if (verdict == "" && rule ~ /^-A INPUT -j ACCEPT$/) verdict = "open"
        if (verdict == "" && rule ~ /^-A INPUT( -i [^ ]+)? -j (DROP|REJECT)( --reject-with [^ ]+)?$/) verdict = "closed"
      }
      /^-A INPUT -j OBHOD$/ { jump = 1 }
      / -j ACCEPT/ && / -p (tcp|udp) / {
        # A rule of the chain this installer adds opens a port only while
        # INPUT jumps to that chain; another tool may have taken the jump out.
        if ($0 ~ /^-A OBHOD / && !jump) next
        proto = ($0 ~ / -p tcp /) ? "tcp" : "udp"
        cnt = split($0, f, " ")
        for (i = 1; i < cnt; i++) if (f[i] == "--dport" || f[i] == "--dports") {
          m = split(f[i + 1], list, ",")
          for (j = 1; j <= m; j++) {
            k = split(list[j], range, ":")
            n++
            pr[n] = proto
            lo[n] = range[1] + 0
            hi[n] = range[k] + 0
          }
        }
      }
      END {
        if (verdict == "" && policy) verdict = "closed"
        if (verdict != "closed") exit
        cnt = split(tcp, t, " ")
        for (i = 1; i <= cnt; i++) if (!let_in("tcp", t[i])) out = out " tcp/" t[i]
        cnt = split(udp, u, " ")
        for (i = 1; i <= cnt; i++) if (!let_in("udp", u[i])) out = out " udp/" u[i]
        print substr(out, 2)
      }'
}

# Xray is one static binary and does not care which init starts it: a
# systemd unit where systemd is the running init, an init script built on
# start-stop-daemon on older Debian-family hosts.
svc_active() {
  if [ "$INIT" = systemd ]; then
    systemctl is-active -q "$UNIT" 2>/dev/null
  else
    [ -x "$INITD" ] && "$INITD" status >/dev/null 2>&1
  fi
}

svc_restart() {
  if [ "$INIT" = systemd ]; then
    systemctl daemon-reload
    systemctl enable -q "$UNIT"
    systemctl restart "$UNIT"
  else
    update-rc.d "$UNIT" defaults >/dev/null
    "$INITD" restart
  fi
}

svc_log() {
  if [ "$INIT" = systemd ]; then
    journalctl -u "$UNIT" -n 30 --no-pager
  else
    tail -n 30 "$PREFIX/log/xray.log"
  fi
}

# Everything runs inside main, called on the last line: bash then reads the
# whole script before running any of it, so a command that reads stdin cannot
# swallow the rest of a script that is itself arriving on stdin.
main() {
  local mode=install deps=no firewall=no tune=no zip="" from=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --check) mode=check ;;
      --uninstall) mode=uninstall ;;
      --install-deps) deps=yes ;;
      --open-firewall) firewall=yes ;;
      --from)
        [ $# -ge 2 ] || die "--from needs a list of addresses"
        from="${2//,/ }"
        shift
        ;;
      --tune-network) tune=yes ;;
      --xray-zip)
        [ $# -ge 2 ] || die "--xray-zip needs a path"
        zip="$2"
        shift
        ;;
      *) die "unknown option $1" ;;
    esac
    shift
  done

  [ "$(id -u)" -eq 0 ] || die "run as root"
  # The directory systemd creates when it is the running init. The override
  # exists for the installer's own tests.
  local sd_dir="${OBHOD_SYSTEMD_DIR:-/run/systemd/system}"
  if [ -d "$sd_dir" ] && command -v systemctl >/dev/null 2>&1; then
    INIT=systemd
  elif [ -d "${INITD%/*}" ] && command -v start-stop-daemon >/dev/null 2>&1 && command -v update-rc.d >/dev/null 2>&1; then
    INIT=sysv
  else
    die "no supported init system: this host has neither systemd nor sysvinit with start-stop-daemon"
  fi

  if [ "$mode" = uninstall ]; then
    if [ "$INIT" = systemd ]; then
      systemctl disable --now "$UNIT" 2>/dev/null || true
      rm -f "/etc/systemd/system/$UNIT.service"
      systemctl daemon-reload
    else
      if [ -x "$INITD" ]; then "$INITD" stop || true; fi
      update-rc.d -f "$UNIT" remove >/dev/null 2>&1 || true
      rm -f "$INITD"
    fi
    rm -f /etc/sysctl.d/99-obhod.conf
    if [ -x "$PREFIX/bin/firewall" ]; then "$PREFIX/bin/firewall" close || true; fi
    rm -rf "$PREFIX"
    if id "$SVC_USER" >/dev/null 2>&1; then userdel "$SVC_USER" || true; fi
    say "removed (ufw and firewalld rules and already applied sysctl values, if any, stay)"
    exit 0
  fi

  # ---- Preflight: read-only. Every problem is collected and reported
  # ---- before anything on the host is changed.
  local problems="" asset="" kver kmaj kmin sdver=0 initdesc=sysvinit ambient=yes lowport=no need="" p tool

  case "$(uname -m)" in
    x86_64 | amd64) asset=Xray-linux-64.zip ;;
    aarch64 | arm64) asset=Xray-linux-arm64-v8a.zip ;;
    *) problems="$problems\n- unsupported architecture $(uname -m)" ;;
  esac

  kver="$(uname -r)"
  kmaj="${kver%%.*}"
  kmin="${kver#*.}"
  kmin="${kmin%%[!0-9]*}"
  case "$kmaj$kmin" in
    '' | *[!0-9]*)
      say "cannot parse kernel version $kver; skipping the kernel check"
      kmaj=99
      kmin=0
      ;;
  esac
  # Xray is a Go program, and the Go runtime needs Linux 3.2 or newer.
  if ! ver_ge "$kmaj" "$kmin" 3 2; then
    problems="$problems\n- kernel $kver is too old: Xray needs Linux 3.2 or newer"
  fi

  # Binding a port below 1024 as an unprivileged user relies on ambient
  # capabilities: systemd 229+ on Linux 4.3+. Sysvinit has no equivalent.
  if [ "$INIT" = systemd ]; then
    sdver="$(systemctl --version 2>/dev/null | awk 'NR==1{print $2}')"
    case "$sdver" in '' | *[!0-9]*) sdver=0 ;; esac
    initdesc="systemd $sdver"
  fi
  if [ "$sdver" -lt 229 ] || ! ver_ge "$kmaj" "$kmin" 4 3; then ambient=no; fi
  for p in $TCP_PORTS $UDP_PORTS; do
    if [ "$p" -lt 1024 ]; then lowport=yes; fi
  done
  if [ "$lowport" = yes ] && [ "$ambient" = no ]; then
    problems="$problems\n- this host ($initdesc, kernel $kver) cannot give an unprivileged service a port below 1024: move the node to ports above 1024"
  fi

  for tool in unzip sha256sum; do
    if ! command -v "$tool" >/dev/null 2>&1; then need="$need $tool"; fi
  done
  if [ -z "$zip" ] && ! command -v curl >/dev/null 2>&1; then need="$need curl"; fi
  if [ -n "$need" ] && [ "$deps" = no ]; then
    problems="$problems\n- missing tools:$need (install them, or rerun with --install-deps)"
  fi
  if [ -n "$zip" ] && [ ! -f "$zip" ]; then
    problems="$problems\n- --xray-zip $zip: no such file"
  fi

  # Ports held by an earlier run of this node are ours to reuse.
  if ! svc_active; then
    for p in $TCP_PORTS; do
      if port_busy tcp "$p"; then problems="$problems\n- TCP port $p is already in use"; fi
    done
    for p in $UDP_PORTS; do
      if port_busy udp "$p"; then problems="$problems\n- UDP port $p is already in use"; fi
    done
  fi

  local free_kb
  free_kb="$(df -Pk /opt 2>/dev/null | awk 'NR==2{print $4}')"
  if [ -z "$free_kb" ]; then free_kb="$(df -Pk / | awk 'NR==2{print $4}')"; fi
  if [ "${free_kb:-0}" -lt 153600 ]; then
    problems="$problems\n- less than 150 MB free for $PREFIX"
  fi

  local fw=none
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
    fw=ufw
  elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
    fw=firewalld
  fi
  # Rules that no manager owns still decide whether the node can be reached.
  local closed=""
  if [ "$fw" = none ]; then
    closed="$(ipt_closed)"
    # The settings file is what an earlier run with --open-firewall left.
    if [ -n "$closed" ] || [ -f "$PREFIX/etc/firewall.conf" ]; then fw=iptables; fi
  fi

  local a ipv4='^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$'
  if [ -n "$from" ] && [ "$firewall" = no ]; then
    problems="$problems\n- --from needs --open-firewall"
  fi
  for a in $from; do
    if ! [[ "$a" =~ $ipv4 ]]; then
      problems="$problems\n- --from $a: not an IPv4 address or network"
    fi
  done
  # shortcut: ufw and firewalld are opened for everyone or not at all; teach
  # them source addresses when a node behind one of them needs it.
  if [ -n "$from" ] && { [ "$fw" = ufw ] || [ "$fw" = firewalld ]; }; then
    problems="$problems\n- --from works only with plain iptables rules, not with $fw: open the ports for these addresses yourself"
  fi
  # The service puts its rules back at every start, as root, which a systemd
  # unit can do for one command only since version 231.
  if [ "$firewall" = yes ] && [ "$fw" = iptables ] && [ "$INIT" = systemd ] && [ "$sdver" -lt 231 ]; then
    problems="$problems\n- opening ports in iptables needs systemd 231 or newer on this host: open them yourself"
  fi

  say "node {{.Node}}: kernel $kver, $initdesc, $(uname -m)"
  say "ports: TCP [$TCP_PORTS] UDP [$UDP_PORTS]; firewall manager: $fw"
  if [ -n "$problems" ]; then
    printf 'cannot install:%b\n' "$problems" >&2
    exit 1
  fi
  if [ "$mode" = check ]; then
    say "preflight passed; nothing was changed"
    if [ -n "$need" ]; then say "would install:$need"; fi
    if [ "$fw" = iptables ] && [ "$firewall" = yes ]; then
      say "would open the ports in iptables for ${from:-any address}"
    elif [ -n "$closed" ]; then
      say "iptables rules close $closed: add --open-firewall or open them yourself"
    elif [ "$fw" != none ] && [ "$fw" != iptables ] && [ "$firewall" = no ]; then
      say "$fw is active and the ports would stay closed: add --open-firewall or open them yourself"
    fi
    if [ -n "$from" ] && [ "$fw" = none ]; then
      say "found no firewall rule that closes the ports on this host, so --from changes nothing: every address can reach them"
    fi
    exit 0
  fi

  # ---- Install.
  if [ -n "$need" ]; then
    say "installing:$need"
    if command -v apt-get >/dev/null 2>&1; then
      DEBIAN_FRONTEND=noninteractive apt-get update -qq
      # shellcheck disable=SC2086
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq $need >/dev/null
    elif command -v dnf >/dev/null 2>&1; then
      # shellcheck disable=SC2086
      dnf install -y -q $need >/dev/null
    elif command -v yum >/dev/null 2>&1; then
      # shellcheck disable=SC2086
      yum install -y -q $need >/dev/null
    else
      die "no known package manager; install these tools yourself:$need"
    fi
  fi

  install -d -m 0755 "$PREFIX" "$PREFIX/bin" "$PREFIX/share"
  install -d -m 0750 "$PREFIX/etc"
  if ! id "$SVC_USER" >/dev/null 2>&1; then
    local nologin=/usr/sbin/nologin
    if [ ! -x "$nologin" ]; then nologin=/sbin/nologin; fi
    useradd --system --no-create-home --shell "$nologin" "$SVC_USER"
  fi
  chown root:"$SVC_USER" "$PREFIX/etc"

  local have=""
  if [ -x "$PREFIX/bin/xray" ]; then have="$(cat "$PREFIX/bin/.version" 2>/dev/null || true)"; fi
  if [ "$have" != "$XRAY_VERSION" ]; then
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    if [ -n "$zip" ]; then
      say "using $zip (its checksum is your responsibility)"
      cp "$zip" "$tmp/xray.zip"
    else
      say "downloading Xray $XRAY_VERSION"
      local base="https://github.com/XTLS/Xray-core/releases/download/$XRAY_VERSION" want got
      curl -fsSL --retry 3 -o "$tmp/xray.zip" "$base/$asset"
      curl -fsSL --retry 3 -o "$tmp/xray.dgst" "$base/$asset.dgst"
      want="$(grep -iE '^SHA2?-?256' "$tmp/xray.dgst" | head -n1 | sed 's/.*= *//' | tr -d '[:space:]')"
      got="$(sha256sum "$tmp/xray.zip" | cut -d' ' -f1)"
      [ -n "$want" ] || die "no SHA-256 in the release digest file"
      [ "$want" = "$got" ] || die "checksum mismatch for $asset: want $want, got $got"
    fi
    unzip -q -o "$tmp/xray.zip" -d "$tmp/x"
    install -m 0755 "$tmp/x/xray" "$PREFIX/bin/xray"
    install -m 0644 "$tmp/x/geoip.dat" "$tmp/x/geosite.dat" "$PREFIX/share/"
    printf '%s\n' "$XRAY_VERSION" > "$PREFIX/bin/.version"
  fi

  local new="$PREFIX/etc/config.new.json"
  umask 027
  cat > "$new" <<'OBHOD_CONFIG_EOF'
{{.Config}}
OBHOD_CONFIG_EOF
  chown root:"$SVC_USER" "$new"
  chmod 0640 "$new"

  say "checking the config"
  if ! XRAY_LOCATION_ASSET="$PREFIX/share" "$PREFIX/bin/xray" run -test -config "$new"; then
    rm -f "$new"
    die "Xray rejected the config; the running service was left untouched"
  fi
  if [ -f "$PREFIX/etc/config.json" ]; then
    cp -p "$PREFIX/etc/config.json" "$PREFIX/etc/config.json.bak"
  fi
  mv "$new" "$PREFIX/etc/config.json"

  # Where the host's own iptables rules close the ports, the node keeps a
  # helper that lets them through, and its service runs the helper at every
  # start: a rule added once by hand is gone after a reboot. What an earlier
  # run set up stays in force until --open-firewall is given again.
  if [ "$firewall" = yes ] && [ "$fw" = iptables ]; then
    cat > "$PREFIX/etc/firewall.conf" <<FWCONF_EOF
TCP='$TCP_PORTS'
UDP='$UDP_PORTS'
FROM='$from'
FWCONF_EOF
    cat > "$PREFIX/bin/firewall" <<'OBHOD_FIREWALL_EOF'
#!/bin/sh
# Lets this node's ports through plain iptables rules: "open" puts the rules
# in, anything else only takes them out. Whatever an earlier run left is
# removed first, so running it again does not pile rules up.
. "${0%/*}/../etc/firewall.conf"
iptables -D INPUT -j OBHOD 2>/dev/null
iptables -F OBHOD 2>/dev/null
iptables -X OBHOD 2>/dev/null
[ "$1" = open ] || exit 0
iptables -N OBHOD
for src in ${FROM:-0.0.0.0/0}; do
  for p in $TCP; do iptables -A OBHOD -p tcp -s "$src" --dport "$p" -j ACCEPT; done
  for p in $UDP; do iptables -A OBHOD -p udp -s "$src" --dport "$p" -j ACCEPT; done
done
iptables -I INPUT 1 -j OBHOD
OBHOD_FIREWALL_EOF
    chmod 0755 "$PREFIX/bin/firewall"
  fi
  # "-" keeps a failed helper from stopping the node, "+" runs it as root
  # outside the restrictions the unit puts on Xray.
  local fwhook=""
  if [ -f "$PREFIX/etc/firewall.conf" ]; then fwhook="ExecStartPre=-+$PREFIX/bin/firewall open"; fi

  # Without ambient capabilities the node runs on high ports (checked above)
  # and needs no capability at all.
  local caps=""
  if [ "$ambient" = yes ]; then
    caps="AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE"
  fi
  if [ "$INIT" = systemd ]; then
    cat > "/etc/systemd/system/$UNIT.service" <<UNIT_EOF
[Unit]
Description=Xray (obhod node {{.Node}})
After=network-online.target
Wants=network-online.target

[Service]
User=$SVC_USER
Environment=XRAY_LOCATION_ASSET=$PREFIX/share
$fwhook
ExecStart=$PREFIX/bin/xray run -config $PREFIX/etc/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
$caps
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
UNIT_EOF
  else
    install -d -m 0750 "$PREFIX/log"
    chown "$SVC_USER" "$PREFIX/log"
    # shortcut: nothing restarts Xray if it dies and its log is never rotated;
    # add respawn and logrotate, or move the host to systemd, if either bites.
    cat > "$INITD" <<INIT_EOF
#!/bin/sh
### BEGIN INIT INFO
# Provides:          $UNIT
# Required-Start:    \$network \$remote_fs
# Required-Stop:     \$network \$remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Xray (obhod node {{.Node}})
### END INIT INFO
PIDFILE=/var/run/$UNIT.pid
case "\$1" in
  start)
    if [ -x $PREFIX/bin/firewall ]; then $PREFIX/bin/firewall open || true; fi
    ulimit -n 65536 2>/dev/null || true
    start-stop-daemon --start --quiet --oknodo --background --make-pidfile --pidfile "\$PIDFILE" \\
      --user $SVC_USER --chuid $SVC_USER --startas /bin/sh -- -c \\
      "exec env XRAY_LOCATION_ASSET=$PREFIX/share $PREFIX/bin/xray run -config $PREFIX/etc/config.json >>$PREFIX/log/xray.log 2>&1"
    ;;
  stop)
    start-stop-daemon --stop --quiet --oknodo --retry 5 --pidfile "\$PIDFILE" --user $SVC_USER
    rm -f "\$PIDFILE"
    ;;
  restart)
    "\$0" stop
    "\$0" start
    ;;
  status)
    [ -f "\$PIDFILE" ] && kill -0 "\$(cat "\$PIDFILE")" 2>/dev/null
    ;;
  *)
    echo "usage: \$0 start|stop|restart|status" >&2
    exit 2
    ;;
esac
INIT_EOF
    chmod 0755 "$INITD"
  fi

  if [ "$tune" = yes ]; then
    cat > /etc/sysctl.d/99-obhod.conf <<'SYSCTL_EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
SYSCTL_EOF
    # Only this file: re-applying every sysctl file could undo settings
    # someone changed by hand on this host.
    sysctl -q -p /etc/sysctl.d/99-obhod.conf >/dev/null 2>&1 || say "could not apply the network settings"
  fi

  # Never turn a firewall on here: that could cut off the SSH session this
  # script is running in.
  if [ "$firewall" = yes ] && [ "$fw" = ufw ]; then
    for p in $TCP_PORTS; do ufw allow "$p/tcp" >/dev/null; done
    for p in $UDP_PORTS; do ufw allow "$p/udp" >/dev/null; done
    say "opened ports in ufw"
  elif [ "$firewall" = yes ] && [ "$fw" = firewalld ]; then
    for p in $TCP_PORTS; do firewall-cmd -q --permanent --add-port="$p/tcp"; done
    for p in $UDP_PORTS; do firewall-cmd -q --permanent --add-port="$p/udp"; done
    firewall-cmd -q --reload
    say "opened ports in firewalld"
  elif [ "$firewall" = yes ] && [ "$fw" = iptables ]; then
    say "the service opens the ports in iptables for ${from:-any address} at every start"
  elif [ -n "$closed" ]; then
    say "iptables rules close $closed and were left alone: open the ports yourself or rerun with --open-firewall"
  elif [ "$fw" != none ] && [ "$fw" != iptables ]; then
    say "$fw is active and was left alone: open the ports yourself or rerun with --open-firewall"
  fi
  if [ -n "$from" ] && [ "$fw" = none ]; then
    say "found no firewall rule that closes the ports on this host, so --from changes nothing: every address can reach them"
  fi

  svc_restart
  sleep 2
  if ! svc_active; then
    svc_log >&2 || true
    if [ -f "$PREFIX/etc/config.json.bak" ]; then
      cp -p "$PREFIX/etc/config.json.bak" "$PREFIX/etc/config.json"
      svc_restart || true
      die "the new config did not start; the previous config was put back"
    fi
    die "$UNIT did not start; see the log above"
  fi
  # The helper's failure does not stop the node, so look at the result.
  if [ -f "$PREFIX/etc/firewall.conf" ]; then
    closed="$(ipt_closed)"
    if [ -n "$closed" ]; then
      say "warning: iptables rules still close $closed; run $PREFIX/bin/firewall open by hand to see why"
    fi
  fi

  say "node {{.Node}} is up: TCP [$TCP_PORTS] UDP [$UDP_PORTS]"
  say "if the hosting provider has its own firewall, open the same ports there"
}

main "$@"
