#!/usr/bin/env bash
# Installer for node "{{.Node}}", generated by obhod. Safe to run again: it
# replaces the config and restarts the service only after the new config
# passes Xray's own check.
#
#   ssh root@SERVER 'bash -s' < install.sh
#   ssh root@SERVER 'bash -s -- --uninstall' < install.sh
#
# This file contains the node's private keys. Do not publish it.
set -euo pipefail

XRAY_VERSION='{{.XrayVersion}}'
PREFIX=/opt/obhod
UNIT=obhod-xray
SVC_USER=obhod
TCP_PORTS='{{.TCPPorts}}'
UDP_PORTS='{{.UDPPorts}}'

say() { printf '>> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# Everything runs inside main, called on the last line: bash then reads the
# whole script before running any of it, so a command that reads stdin cannot
# swallow the rest of a script that is itself arriving on stdin.
main() {
[ "$(id -u)" -eq 0 ] || die "run as root"
command -v systemctl >/dev/null || die "systemd is required"

if [ "${1:-}" = "--uninstall" ]; then
  systemctl disable --now "$UNIT" 2>/dev/null || true
  rm -f "/etc/systemd/system/$UNIT.service" /etc/sysctl.d/99-obhod.conf
  systemctl daemon-reload
  rm -rf "$PREFIX"
  id "$SVC_USER" >/dev/null 2>&1 && userdel "$SVC_USER" || true
  say "removed"
  exit 0
fi

case "$(uname -m)" in
  x86_64 | amd64) ASSET=Xray-linux-64.zip ;;
  aarch64 | arm64) ASSET=Xray-linux-arm64-v8a.zip ;;
  *) die "unsupported architecture $(uname -m)" ;;
esac

need=""
for tool in curl unzip sha256sum; do
  command -v "$tool" >/dev/null || need="$need $tool"
done
if [ -n "$need" ]; then
  say "installing:$need"
  if command -v apt-get >/dev/null; then
    DEBIAN_FRONTEND=noninteractive apt-get update -qq
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq curl unzip coreutils >/dev/null
  elif command -v dnf >/dev/null; then
    dnf install -y -q curl unzip coreutils >/dev/null
  else
    die "install these tools first:$need"
  fi
fi

install -d -m 0755 "$PREFIX" "$PREFIX/bin" "$PREFIX/share"
install -d -m 0750 "$PREFIX/etc"
id "$SVC_USER" >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin "$SVC_USER"
chown root:"$SVC_USER" "$PREFIX/etc"

have=""
[ -x "$PREFIX/bin/xray" ] && have="$(cat "$PREFIX/bin/.version" 2>/dev/null || true)"
if [ "$have" != "$XRAY_VERSION" ]; then
  say "downloading Xray $XRAY_VERSION"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  base="https://github.com/XTLS/Xray-core/releases/download/$XRAY_VERSION"
  curl -fsSL --retry 3 -o "$tmp/xray.zip" "$base/$ASSET"
  curl -fsSL --retry 3 -o "$tmp/xray.dgst" "$base/$ASSET.dgst"
  want="$(grep -iE '^SHA2?-?256' "$tmp/xray.dgst" | head -n1 | sed 's/.*= *//' | tr -d '[:space:]')"
  got="$(sha256sum "$tmp/xray.zip" | cut -d' ' -f1)"
  [ -n "$want" ] || die "no SHA-256 in the release digest file"
  [ "$want" = "$got" ] || die "checksum mismatch for $ASSET: want $want, got $got"
  unzip -q -o "$tmp/xray.zip" -d "$tmp/x"
  install -m 0755 "$tmp/x/xray" "$PREFIX/bin/xray"
  install -m 0644 "$tmp/x/geoip.dat" "$tmp/x/geosite.dat" "$PREFIX/share/"
  printf '%s\n' "$XRAY_VERSION" > "$PREFIX/bin/.version"
fi

new="$PREFIX/etc/config.json.new"
umask 027
cat > "$new" <<'OBHOD_CONFIG_EOF'
{{.Config}}
OBHOD_CONFIG_EOF
chown root:"$SVC_USER" "$new"
chmod 0640 "$new"

say "checking the config"
if ! XRAY_LOCATION_ASSET="$PREFIX/share" "$PREFIX/bin/xray" run -test -config "$new"; then
  rm -f "$new"
  die "Xray rejected the config; the running service was left untouched"
fi
[ -f "$PREFIX/etc/config.json" ] && cp -p "$PREFIX/etc/config.json" "$PREFIX/etc/config.json.bak"
mv "$new" "$PREFIX/etc/config.json"

cat > "/etc/systemd/system/$UNIT.service" <<UNIT_EOF
[Unit]
Description=Xray (obhod node {{.Node}})
After=network-online.target
Wants=network-online.target

[Service]
User=$SVC_USER
Environment=XRAY_LOCATION_ASSET=$PREFIX/share
ExecStart=$PREFIX/bin/xray run -config $PREFIX/etc/config.json
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
UNIT_EOF

# BBR for the TCP transports, larger socket buffers for QUIC.
cat > /etc/sysctl.d/99-obhod.conf <<'SYSCTL_EOF'
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
SYSCTL_EOF
sysctl -q --system >/dev/null 2>&1 || say "could not apply sysctl settings (fine inside a container)"

# Open ports only in a firewall that is already on; never turn one on here,
# which could cut off the SSH session this script is running in.
if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q '^Status: active'; then
  for p in $TCP_PORTS; do ufw allow "$p/tcp" >/dev/null; done
  for p in $UDP_PORTS; do ufw allow "$p/udp" >/dev/null; done
  say "opened ports in ufw"
elif command -v firewall-cmd >/dev/null && firewall-cmd --state >/dev/null 2>&1; then
  for p in $TCP_PORTS; do firewall-cmd -q --permanent --add-port="$p/tcp"; done
  for p in $UDP_PORTS; do firewall-cmd -q --permanent --add-port="$p/udp"; done
  firewall-cmd -q --reload
  say "opened ports in firewalld"
fi

systemctl daemon-reload
systemctl enable -q "$UNIT"
systemctl restart "$UNIT"
sleep 2
if ! systemctl is-active -q "$UNIT"; then
  journalctl -u "$UNIT" -n 30 --no-pager >&2 || true
  die "$UNIT did not stay up; the previous config is in $PREFIX/etc/config.json.bak"
fi

say "node {{.Node}} is up: TCP [$TCP_PORTS] UDP [$UDP_PORTS]"
say "if the hosting provider has its own firewall, open the same ports there"
}

main "$@"
